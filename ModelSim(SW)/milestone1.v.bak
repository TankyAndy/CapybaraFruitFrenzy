module milestone1(SW,CLOCK_50,LEDR,HEX0,HEX1,VGA_R,VGA_G,VGA_B,VGA_HS,VGA_VS,VGA_BLANK_N,VGA_SYNC_N,VGA_CLK);
    input CLOCK_50;
    input [2:0] SW;
	 output [6:0] HEX0, HEX1;
    output reg [9:0] LEDR;
	 output [7:0] VGA_R;
    output [7:0] VGA_G;
    output [7:0] VGA_B;
    output VGA_HS;
    output VGA_VS;
    output VGA_BLANK_N;
    output VGA_SYNC_N;
    output VGA_CLK;

    //wire [87:0] x;
    //wire [87:0] y;
    //wire [7:0] s;
    reg [25:0] count;
    reg [10:0] xEdit [0:7];
    reg [10:0] yEdit [0:7];
    reg [7:0] sEdit;
    reg [2:0] health;
	 reg [3:0] score;
    reg [9:0] yThreshold = 430;
	 reg [7:0] colour;
	 wire [7:0] fruitColour;
	 assign fruitColour = 8'b11111111; 
	 wire [7:0] backgroundColour;
	 assign backgroundColour = 8'b00000000;
	 reg plot;
    integer i;
	 integer k;
    reg reset;
    reg [1:0] state;
    reg [9:0] variance[0:7];
    reg [9:0] variationy [0:7];

    //the variance variable is a constant. basically, whenever the fruit
    //reaches the y threshhold or the fruit is "removed" it resets to the
    //top of the screen. the x coordinate has to + variance so it appears
    //in a different spot. variance needs to be the opposite sign every time. 
    //so when the fruit resets once, i add 20. when it resets again, i add -20.

    //CONTROLS:
    //SW[0] = 0 -> GAME_START
    //SW[0] = 1 -> GAME_ON

    //SW[1] = 1 -> remove fruit

    //SW[2] = 1 -> go back to GAME_START

    //INDICATORS
    //LEDR 0 and rest 0 -> state1 which is GAME_START
    //LEDR 1 and rest 0 -> state2 which is GAME_ON
        //LEDR 9-6 -> fruit hit ground
        //LEDR 5 -> blinking means fruit falling
        //LEDR 3 -> success remove fruit
    //LEDR 2 and rest 0 -> state3 which is GAME_OVER

    parameter GAME_START = 2'b00, GAME_ON = 2'b01, GAME_OVER = 2'b10;       
	 parameter CLEAR = 2'b00, DRAW = 2'b01;

    reg [1:0] draw_state;
    reg [10:0] xPlot, yPlot;
	 reg [9:0] x;     // Counts up to 640 (screen width)
    reg [9:0] y;     // Counts up to 480 (screen height)
    reg [3:0] current; // Keep track of which fruit we're drawing
    //fruits fruit_instances (CLOCK_50, reset, xEdit, yEdit, sEdit, x, y, s);
	 seg7_binaryToHex sc(score, HEX1);
	 seg7_binaryToHex hp(health, HEX0);
	 
	 vga_adapter VGA (
    .resetn(SW[0]), 
    .clock(CLOCK_50),
    .x(xPlot),
    .y(yPlot),
    .colour(colour),
    .plot(plot), // Signal to plot the pixel
    .VGA_R(VGA_R), 
    .VGA_G(VGA_G), 
    .VGA_B(VGA_B),
    .VGA_HS(VGA_HS),
    .VGA_VS(VGA_VS),
    .VGA_BLANK_N(VGA_BLANK_N),
    .VGA_SYNC_N(VGA_SYNC_N),
    .VGA_CLK(VGA_CLK)
	 );

    always @(posedge CLOCK_50) begin

	 
        if(SW[0] == 0)begin
            state <= GAME_START;
        end

        case(state)

            GAME_START: begin
                
                for (i = 0; i < 8; i = i + 1) begin
				variationy[i] <= 5 + (i * 10);
                xEdit[i] <= 69 + i * 10; //in real game, x[i] <= i * 30 to distribute across x
                yEdit[i] <= 410 - variationy[i];
                sEdit[i] <= 0;
            end

                reset <= 1;
                health <= 3'b101;
					 score <= 4'b0;
                count <= 26'b0;
                LEDR[9:1] <= 9'b0;
                LEDR[0] <= 1;
					 draw_state <= CLEAR;
					 

                if(SW[0] == 0)begin //SW[0] to start game. 
                    state <= GAME_START;
                end else begin
                    state <= GAME_ON;
                end
            end

            GAME_ON: begin
                reset <= 0;
                state <= GAME_ON;
					 //colour <= backgroundColour;
					 //plot <= 1'b1;
                if (count == 20) begin //1 second just to test.
                    count <= 0;
                    LEDR[9:6] <= 4'b0;
                    LEDR[0] <= 0;
                    LEDR[1] <= 1;
                    LEDR[4:2] <= 3'b0;
						

                    for (i = 0; i < 8; i = i + 1) begin // Loop through each fruit
                        if (yEdit[i] > yThreshold) begin // If the fruit hits the ground
                            //reset position to the top at a different x coord.
                            variance[i] <= -variance[i];
                            yEdit[i] <= 420;
                            xEdit[i] <= xEdit[i] + -variance[i];
                            health <= health - 1;
                            LEDR[9:6] <= 4'b1111;
                         
                        end else if (health == 0) begin//if health = 0 game over.
                                state <= GAME_OVER;
								end else if(SW[1] == 1)begin//sw[1] to "shoot" or remove a ball
                                //reset position to the top at a different x coord
                                variance[i] <= -variance[i];
                                yEdit[i] <= 420;
                                xEdit[i] <= xEdit[i] + variance[i];
                                sEdit[i] <= 1;
										  score <= score + 1;
                                LEDR[3] <= 1;

                        end else begin
                                //normal falling fruit behavior
                                xEdit[i] <= xEdit[i];
                                yEdit[i] <= yEdit[i] + 1;
                                sEdit[i] <= 0;
                                LEDR[5] <= ~LEDR[5];
										  //colour <= fruitColour;
										  //plot <= 1'b1;
                        end
					 
					 /*
					 case(draw_state)
                    CLEAR: begin
                        colour <= backgroundColour;
                        plot <= 1'b1;
                        draw_state <= DRAW;
                    end

                    DRAW: begin
                        xPlot <= xEdit[(i+1)*11-1 -: 11];
                        yPlot <= yEdit[(i+1)*11-1 -: 11];
                        colour <= fruitColour;
                        plot <= 1'b1;
                        draw_state <= CLEAR;
                    end
                endcase
					 */
					 end
					 end
					 case(draw_state)
					 
            CLEAR: begin
                // Clear screen
                if(x < 640 && y < 480) begin
                    xPlot <= x;
                    yPlot <= y;
                    colour <= backgroundColour;
                    plot <= 1'b1;

                    // Increment counters
                    if(x == 639) begin
                        x <= 0;
                        if(y == 479) begin
                            y <= 0;
                            draw_state <= DRAW;
                            current <= 0;
                        end
                        else
                            y <= y + 1;
                    end
                    else
                        x <= x + 1;
                end
            end

            DRAW: begin
                // Draw fruits
                if(current < 8) begin
                    // Draw each fruit as a 5x5 square for visibility
                    xPlot <= xEdit[current];
                    yPlot <= yEdit[current];
                    colour <= fruitColour;
                    plot <= 1'b1;
                    current <= current + 1;
                end
                else begin
                    current <= 0;
                    draw_state <= CLEAR;
                end
            end
        endcase
					 count <= count + 1;
            end

            GAME_OVER: begin
                state <= GAME_OVER;
                LEDR[9:3] <= 7'b0;
                LEDR[2] <= 1;
                LEDR[1:0] <= 2'b0;
                if(SW[2] == 1)begin //SW[2] to reset game
                    state <= GAME_START;
                end
         end 

        endcase
    end
endmodule



